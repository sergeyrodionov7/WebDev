{
  "name": "intra",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.3",
    "npm": ">=11"
  },
  "scripts": {
    "serve": "vite ./src",
    "dev": "vite ./src",
    "start": "vite ./src",
    "build": "npm run typecheck && vite build ./src",
    "preview": "vite preview ./src",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
